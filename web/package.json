{
  "name": "battle-sim-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "npm run build && node tools/bundle-single-file.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "wasm": "wasm-pack build ../crates/sim-wasm --target web --out-dir ../../web/src/wasm --out-name sim",
    "smoke": "node tools/smoke.mjs",
    "smoke:scenario": "node tools/scenario-smoke.mjs",
    "smoke:ui": "node tools/ui-smoke.mjs",
    "smoke:performance": "node tools/performance-smoke.mjs",
    "smoke:cache": "node tools/terrain-cache-smoke.mjs",
    "smoke:single": "node tools/single-file-smoke.mjs"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
